# Production environment variables example configuration

# Backend API server configuration
PORT=5000
NODE_ENV=production
API_TIMEOUT=30000
CORS_ORIGIN=http://localhost

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@postgres:5432/task_dashboard?schema=public

# Security tokens keys
JWT_SECRET=replace_with_a_secure_long_random_string_in_production
JWT_EXPIRES_IN=1d

# Frontend configuration (handled by Nginx internally, but documented here)
VITE_API_URL=/api
