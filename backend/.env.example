# Application Port
PORT=5000

# Node Environment (development, production, test)
NODE_ENV=development

# Database URL for PostgreSQL instance connection (Replace placeholder credentials)
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name

# JWT secret key for signature generation (change in production to a secure random string!)
JWT_SECRET=your_jwt_secret_key_here

# JWT Token Expiry Duration (e.g. 1d, 7d, 2h)
JWT_EXPIRES_IN=1d

# API Timeout Limit in milliseconds (default: 30000ms = 30s)
API_TIMEOUT=30000

# Allowed CORS Origins (separate with commas or use * for all)
CORS_ORIGIN=*
